{
  "resource": "https://api.deck.co/v2",
  "authorization_servers": ["https://deck.co"],
  "bearer_methods_supported": ["header"],
  "scopes_supported": [
    "read:agents",
    "write:agents",
    "read:credentials",
    "write:credentials",
    "read:sessions",
    "write:sessions",
    "read:sources",
    "write:sources",
    "read:tasks",
    "write:tasks",
    "read:task-runs",
    "write:task-runs",
    "read:triggers",
    "write:triggers",
    "read:events",
    "write:events",
    "read:event-destinations",
    "write:event-destinations",
    "read:storage",
    "write:storage",
    "read:components",
    "write:components",
    "read:*",
    "write:*"
  ],
  "resource_name": "Deck API",
  "resource_documentation": "https://docs.deck.co/api-reference",
  "tls_client_certificate_bound_access_tokens": false
}
